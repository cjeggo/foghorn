     ]
    }
   }
  },
  {
   "id": "d35c9d8c-2c0e-46b6-b292-fa562ba8fa91",
   "name": "Build SQLMap Command",
   "type": "n8n-nodes-base.code",
   "typeVersion": 2,
   "position": [
    220,
    0
   ],
   "parameters": {
    "jsCode": "\nconst origin = $json.origin;\nconst command = `timeout 180 sqlmap -u \"${origin}/\" --crawl=2 --forms --batch --level=1 --risk=1 --output-dir=/tmp/sqlmap --disable-coloring 2>&1 || true`;\nreturn [{ json: { target: $json.target, origin, command } }];\n"
   }
  },
  {
   "id": "6fc29d82-fb80-47ac-b1e4-8043fdc35773",
   "name": "Run SQLMap",
   "type": "n8n-nodes-base.executeCommand",
   "typeVersion": 1,
   "position": [
    440,
    0
   ],
   "parameters": {
    "command": "={{$json.command}}"
   }
  },
  {
   "id": "81cecfbf-8ed7-4538-abd8-04776f86c1fa",
   "name": "Parse SQLMap Findings",
   "type": "n8n-nodes-base.code",
   "typeVersion": 2,
   "position": [
    660,
    0
   ],
   "parameters": {
    "jsCode": "\nconst stdout = $json.stdout || '';\nconst findings = [];\nconst paramBlocks = stdout.split(/Parameter:\\s+/).slice(1);\nfor (const block of paramBlocks) {\n  const paramName = block.split(/[\\s(]/)[0];\n  const typeMatch = block.match(/Type:\\s*(.+)/);\n  const titleMatch = block.match(/Title:\\s*(.+)/);\n  findings.push({ parameter: paramName, type: typeMatch ? typeMatch[1].trim() : null, title: titleMatch ? titleMatch[1].trim() : null });\n}\nconst vulnerable = /sqlmap identified the following injection point/i.test(stdout) || findings.length > 0;\nreturn [{ json: { skipped: false, vulnerable, findings } }];\n"
   }
  }
 ],
